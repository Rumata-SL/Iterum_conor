{
  "compilerOptions": {
    "outDir": "./dist/",
    "noImplicitAny": true,
    "module": "ESNext",
    "target": "es5",
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "baseUrl": ".",
    "strict": true,
    "paths": {
      "*": [
        "./src/*"
      ]
    },
    "allowSyntheticDefaultImports": true,
    "types": [
      "node"
    ]
  },
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS",
      "types": [
        "@testing-library/jest-dom",
        "node"
      ]
    },
    "include": [
      "./config/jest/setupTests.ts",
      "./src/**/*.ts",
      "./src/**/*.tsx"
    ]
  }
}